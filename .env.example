# ──────────────────────────────────────────────
# Skillorbit.ai — environment variables
# Copy this file to `.env.local` for local dev,
# and add the same variables to Vercel for prod.
# ──────────────────────────────────────────────

# --- Supabase ---
# From: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-jwt-here
# Service role (server-only, never expose to browser).
# This is the long JWT labelled "service_role".
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-jwt-here

# --- Anthropic (server-side only) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Rate limiting (optional but strongly recommended in prod) ---
# Sign up free at upstash.com → Redis → Create database.
# If unset, the API still works but is unprotected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase 2: Stripe (placeholder, not used yet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
